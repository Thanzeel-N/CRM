# ─── Environment ───────────────────────────────────────────────────────────────
APP_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────────
# MySQL (recommended for production)
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# ─── Security ──────────────────────────────────────────────────────────────────
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION

# ─── Host / CORS ───────────────────────────────────────────────────────────────
# Your production domain (used in CORS and OAuth redirect URIs)
HOST_URL=https://YOUR_DOMAIN

# Optional: comma-separated extra allowed CORS origins
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# ─── Meta (Facebook) App ───────────────────────────────────────────────────────
META_APP_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME

# Must match the verify token entered in the Meta Developer Dashboard → Webhooks
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_SECURE_RANDOM_STRING

# ─── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME

# ─── Google Sheets Integration (optional) ──────────────────────────────────────
# Path to the service account JSON key file from Google Cloud Console.
# Leave empty to disable Google Sheets sync.
# GOOGLE_SHEETS_CREDENTIALS_FILE=/app/credentials/google-service-account.json
